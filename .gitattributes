# Normalize common text files to LF
* text=auto

# Explicit text file types
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cc text eol=lf
*.hh text eol=lf
*.cxx text eol=lf
*.hxx text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.xml text eol=lf
*.xacro text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Keep Windows script semantics
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.pdf binary
*.stl binary
*.dae binary
*.bin binary
*.mp4 binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.so binary
*.a binary
*.dll binary
*.dylib binary
*.pyc binary
*.pyd binary
*.pyo binary
