[submodule "src/yantra_misc/ipm"]
	path = src/yantra_misc/ipm/ipm
	url = https://github.com/ros-sports/ipm.git
[submodule "src/vision_opencv"]
	path = src/vision_opencv
	url = https://github.com/ros-perception/vision_opencv.git
[submodule "src/yantra_misc/DynamixelSDK"]
	path = src/yantra_misc/DynamixelSDK
	url = https://github.com/Altair-Humanoid-GMRT/DynamixelSDK.git
[submodule "src/yantra_misc/robot_localization"]
	path = src/yantra_misc/robot_localization
	url = https://github.com/Altair-Humanoid-GMRT/robot_localization.git
[submodule "src/yantra_hardware/dynamixel-workbench"]
	path = src/yantra_hardware/dynamixel-workbench
