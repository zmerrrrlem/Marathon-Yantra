<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>bezier_kick</name>
    <version>1.0.0</version>
    <description>This is a simple open-loop kick engine that uses a bezier curve to generate the trajectory.
    </description>
    <maintainer email="falahnzk@gmail.com">Falah Naufal Zaki</maintainer>

    <license>MIT</license>

    <author email="falahnzk@gmail.com">Falah Naufal Zaki</author>
    <author>Alfarobi (original version of engine)</author>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>rosidl_default_generators</buildtool_depend>

    <depend>biped_interfaces</depend>
    <depend>builtin_interfaces</depend>

    <depend>bio_ik</depend>
    <depend>yantra_msgs</depend>
    <depend>yantra_robot_description</depend>
    <depend>yantra_splines</depend>
    <depend>control_toolbox</depend>
    <depend>generate_parameter_library</depend>
    <depend>geometry_msgs</depend>
    <depend>moveit_core</depend>
    <depend>moveit_ros_move_group</depend>
    <depend>moveit_ros_planning_interface</depend>
    <depend>moveit_ros_robot_interaction</depend>
    <depend>rclcpp</depend>
    <depend>ros2_python_extension</depend>
    <depend>rot_conv</depend>
    <depend>std_msgs</depend>
    <depend>tf2_eigen</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>tf2</depend>
    <depend>backward_ros</depend>
    <depend>hardware_interface</depend>
    <depend>pluginlib</depend>
    <depend>rclcpp_lifecycle</depend>
    <depend>controller_interface</depend>
    <depend>parameter_traits</depend>
    <depend>control_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>ament_index_cpp</depend>
    <depend>quintic_walk_parameters</depend>

    <!-- <exec_depend>plotjuggler</exec_depend> -->
    <!-- <exec_depend>yantra_odometry</exec_depend> -->
    <exec_depend>ros2launch</exec_depend>
    <exec_depend>rosidl_default_runtime</exec_depend>

    <member_of_group>rosidl_interface_packages</member_of_group>

    <export>
        <!-- <yantra_documentation>
            <status>tested_integration</status>
            <language>c++</language>
        </yantra_documentation> -->
        <build_type>ament_cmake</build_type>
    </export>
</package>
