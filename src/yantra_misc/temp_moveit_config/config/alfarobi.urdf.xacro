<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alfarobi">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import alfarobi urdf file -->
    <xacro:include filename="$(find yantra_description)/urdf/alfarobi_compose.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="alfarobi.ros2_control.xacro" />


    <xacro:alfarobi_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
