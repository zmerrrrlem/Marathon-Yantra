<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- left leg -->
  <xacro:macro name="yantra_left_leg" params="parent">

    <!-- left hip yaw joint -->
    <joint name="l_hip_yaw" type="revolute">
      <parent link="${parent}" />
      <child link="l_hip_yaw_link" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.02448 0.04340 0.03887" />
      <axis xyz="0.00000 0.00000 -1.00000" />
      <limit effort="1000" velocity="100" lower="${-pi*0.9}" upper="${pi*0.9}" />
      <dynamics damping="0.1" friction="0.0" />
    </joint>

    <!-- left hip yaw link -->
    <link name="l_hip_yaw_link">
      <visual>
        <xacro:insert_mesh_l_hip_yaw_link />
      </visual>
      <collision>
        <xacro:insert_mesh_l_hip_yaw_link />
      </collision>
      <inertial>
        <xacro:insert_inertia_l_hip_yaw_link />
      </inertial>
    </link>

    <!-- left hip roll joint -->
    <joint name="l_hip_roll" type="revolute">
      <parent link="l_hip_yaw_link" />
      <child link="l_hip_roll_link" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="-0.06106 -0.00006 -0.07670" />
      <axis xyz="-1.00000 0.00000 0.00000" />
      <limit effort="1000" velocity="100" lower="${-pi*0.9}" upper="${pi*0.9}" />
      <dynamics damping="0.1" friction="0.0" />
    </joint>

    <!-- left hip roll link -->
    <link name="l_hip_roll_link">
      <visual>
        <xacro:insert_mesh_l_hip_roll_link />
      </visual>
      <collision>
        <xacro:insert_mesh_l_hip_roll_link />
      </collision>
      <inertial>
        <xacro:insert_inertia_l_hip_roll_link />
      </inertial>
    </link>

    <!-- left hip pitch joint -->
    <joint name="l_hip_pitch" type="revolute">
      <parent link="l_hip_roll_link" />
      <child link="l_hip_pitch_link" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.05652 -0.02942 0.00064" />
      <axis xyz="0.00000 1.00000 0.00000" />
      <limit effort="1000" velocity="100" lower="${-pi*0.9}" upper="${pi*0.9}" />
      <dynamics damping="0.1" friction="0.0" />
    </joint>

    <!-- left hip pitch link -->
    <link name="l_hip_pitch_link">
      <visual>
        <xacro:insert_mesh_l_hip_pitch_link />
      </visual>
      <collision>
        <xacro:insert_mesh_l_hip_pitch_link />
      </collision>
      <inertial>
        <xacro:insert_inertia_l_hip_pitch_link />
      </inertial>
    </link>

    <!-- left knee joint -->
    <joint name="l_knee" type="revolute">
      <parent link="l_hip_pitch_link" />
      <child link="l_knee_link" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00089 -0.00563 -0.11729" />
      <axis xyz="0.00000 1.00000 0.00000" />
      <limit effort="1000" velocity="100" lower="${-pi*0.9}" upper="${pi*0.9}" />
      <dynamics damping="0.1" friction="0.0" />
    </joint>

    <!-- left knee link -->
    <link name="l_knee_link">
      <visual>
        <xacro:insert_mesh_l_knee_link />
      </visual>
      <collision>
        <xacro:insert_mesh_l_knee_link />
      </collision>
      <inertial>
        <xacro:insert_inertia_l_knee_link />
      </inertial>
    </link>

    <!-- left ankle pitch joint -->
    <joint name="l_ank_pitch" type="revolute">
      <parent link="l_knee_link" />
      <child link="l_ank_pitch_link" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00062 0.04741 -0.11684" />
      <axis xyz="0.00000 -1.00000 0.00000" />
      <limit effort="1000" velocity="100" lower="${-pi*0.9}" upper="${pi*0.9}" />
      <dynamics damping="0.1" friction="0.0" />
    </joint>

    <!-- left ankle pitch link -->
    <link name="l_ank_pitch_link">
      <visual>
        <xacro:insert_mesh_l_ank_pitch_link />
      </visual>
      <collision>
        <xacro:insert_mesh_l_ank_pitch_link />
      </collision>
      <inertial>
        <xacro:insert_inertia_l_ank_pitch_link />
      </inertial>
    </link>

    <!-- left ankle roll joint -->
    <joint name="l_ank_roll" type="revolute">
      <parent link="l_ank_pitch_link" />
      <child link="l_ank_roll_link" />
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00651 -0.01247 -0.03586" />
      <axis xyz="1.00000 0.00000 0.00000" />
      <limit effort="1000" velocity="100" lower="${-pi*0.9}" upper="${pi*0.9}" />
      <dynamics damping="0.1" friction="0.0" />
    </joint>

    <!-- left ankle roll link -->
    <link name="l_ank_roll_link">
      <visual>
        <xacro:insert_mesh_l_ank_roll_link />
      </visual>
      <collision>
        <xacro:insert_mesh_l_ank_roll_link />
      </collision>
      <inertial>
        <xacro:insert_inertia_l_ank_roll_link />
      </inertial>
    </link>

    <joint name="l_sole_joint" type="fixed">
      <origin rpy="0.00000 0.00000 0.00000" xyz="-0.00000 0.00747 -0.03327" />
      <parent link="l_ank_roll_link" />
      <child link="l_sole" />
    </joint>

    <link name="l_sole">
      <collision name="l_ank_roll_collision">
        <origin rpy="0.00000 0.00000 0.00000" xyz="-0.00330 0.00294 0.00309" />
        <geometry>
          <box size="0.14500 0.09500 0.01200" />
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="0.00001" ixy="-0.00000" ixz="-0.00000" iyy="0.00002" iyz="-0.00000"
          izz="0.00003" />
        <origin rpy="0.00000 0.00000 0.00000" xyz="-0.00064 0.00279 -0.00004" />
        <mass value="0.01000" />
      </inertial>
      <visual>
        <xacro:insert_mesh_l_sole />
      </visual>
    </link>

  </xacro:macro>

</robot>