<?xml version="1.0"?>
<robot name="yantra">

  <!-- === Top-level Materials === -->
  <material name="light_gray">
    <color rgba="0.894 0.894 0.894 1" />
  </material>
  <material name="medium_gray">
    <color rgba="0.894 0.894 0.894 1" />
  </material>
  <material name="off_white">
    <color rgba="0.894 0.894 0.894 1" />
  </material>
  <material name="light_blue">
    <color rgba="0.894 0.894 0.894 1" />
  </material>
  <material name="dark_blue">
    <color rgba="0.894 0.894 0.894 1" />
  </material>
  <material name="cyan">
    <color rgba="0.894 0.894 0.894 1" />
  </material>

  <!-- Joint limits set to realistic servo values (were effort=1000 N·m, velocity=100 rad/s,
       which let Gazebo apply huge forces to ~20 g links and pull joints apart).
       Legs 12 N·m, arms/head 6 N·m, claws 2 N·m, all 7 rad/s. -->

  <!-- === Root Torso === -->
  <!-- All limb/head STLs are exported in SolidWorks Y-up / Y-along-limb coordinates. -->
  <!-- The five root limb joints in Yantravira-urdf1.urdf carried rpy="1.5708 -->
  <!-- -0.028365 -0.017449" to rotate the whole subtree into the robot frame. -->
  <!-- Here the joints are normalized to ROS Z-up/X-forward (rpy=0), so that -->
  <!-- same rotation is baked into every mesh <visual>/<collision> origin. -->
  <!-- FIX 2026-11-27: that baked rotation was missing a 90° yaw and each mesh had a different -->
  <!-- offset, so parts sat 1-9 cm away from their joints. Every <visual> origin below was -->
  <!-- re-fitted by matching each mesh to the old meshes/yantra parts (fit error ~1 mm); the -->
  <!-- ankle-roll, elbow and claw meshes take the correction of the neighbour they already fit. -->
  <!-- body_link is defined in yantra_compose.urdf.xacro (visual/collision/inertial) -->

  <!-- === Left Leg === -->

  <!-- Left hip yaw joint -->
  <joint name="l_hip_yaw" type="revolute">
    <parent link="body_link" />
    <child link="l_hip_yaw_link" />
    <origin xyz="0.024 0.043 0.039" rpy="0 0 0" />
    <axis xyz="0 0 -1" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="l_hip_yaw_link">
    <visual>
      <origin xyz="-0.00014 -0.00016 -0.04245" rpy="1.56380 -0.02977 1.56843" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/left_leg_yaw_1.STL" />
      </geometry>
      <material name="light_gray" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 3676-triangle mesh collision) -->
      <origin xyz="0.0000 -0.0001 -0.0660" rpy="0 0 0" />
      <geometry>
        <box size="0.0595 0.0282 0.0475" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="0.0010 -0.0001 -0.0528" rpy="0 0 0" />
      <mass value="0.023" />
      <inertia ixx="4.476e-06" ixy="2.064e-08" ixz="7.338e-07" iyy="1.321e-05" iyz="-2.36e-10" izz="1.202e-05" />
    </inertial>
  </link>

  <!-- Left hip roll joint -->
  <joint name="l_hip_roll" type="revolute">
    <parent link="l_hip_yaw_link" />
    <child link="l_hip_roll_link" />
    <origin xyz="-0.061 -0.001 -0.077" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="l_hip_roll_link">
    <visual>
      <origin xyz="0.08635 -0.00046 0.00102" rpy="1.55957 -0.03509 1.56542" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/left_leg_roll_1.STL" />
      </geometry>
      <material name="off_white" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 18190-triangle mesh collision) -->
      <origin xyz="0.0367 -0.0015 -0.0159" rpy="0 0 0" />
      <geometry>
        <box size="0.1015 0.0536 0.0646" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="0.0346 -0.0001 -0.0145" rpy="0 0 0" />
      <mass value="0.239" />
      <inertia ixx="9.21e-05" ixy="1.061e-06" ixz="-8.447e-06" iyy="0.0002385" iyz="9.899e-07" izz="0.000206" />
    </inertial>
  </link>

  <!-- Left hip pitch joint -->
  <joint name="l_hip_pitch" type="revolute">
    <parent link="l_hip_roll_link" />
    <child link="l_hip_pitch_link" />
    <origin xyz="0.057 -0.029 0.001" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="l_hip_pitch_link">
    <visual>
      <origin xyz="0.00008 0.02935 0.00013" rpy="1.56160 -0.02879 1.57110" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/left_leg_pitch_1.STL" />
      </geometry>
      <material name="light_blue" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 8586-triangle mesh collision) -->
      <origin xyz="0.0008 0.0281 -0.0586" rpy="0 0 0" />
      <geometry>
        <box size="0.0406 0.0535 0.1455" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="0.0008 0.0293 -0.0928" rpy="0 0 0" />
      <mass value="0.142" />
      <inertia ixx="0.0001372" ixy="9.648e-09" ixz="6.579e-07" iyy="0.0001178" iyz="-8.2e-07" izz="4.555e-05" />
    </inertial>
  </link>

  <!-- Left knee joint -->
  <joint name="l_knee" type="revolute">
    <parent link="l_hip_pitch_link" />
    <child link="l_knee_link" />
    <origin xyz="0.001 -0.006 -0.117" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="l_knee_link">
    <visual>
      <origin xyz="0.00062 0.03406 -0.10313" rpy="-1.54793 0.02863 -1.57259" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/left_leg_pitch_3.STL" />
      </geometry>
      <material name="light_blue" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 5084-triangle mesh collision) -->
      <origin xyz="0.0006 0.0345 -0.0581" rpy="0 0 0" />
      <geometry>
        <box size="0.0283 0.0521 0.1177" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="0.0005 0.0345 -0.0581" rpy="0 0 0" />
      <mass value="0.024" />
      <inertia ixx="3.958e-05" ixy="-3.236e-08" ixz="3.79e-08" iyy="2.682e-05" iyz="2.847e-09" izz="1.609e-05" />
    </inertial>
  </link>

  <!-- Left ankle pitch joint -->
  <joint name="l_ank_pitch" type="revolute">
    <parent link="l_knee_link" />
    <child link="l_ank_pitch_link" />
    <origin xyz="0.001 0.047 -0.117" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="l_ank_pitch_link">
    <visual>
      <origin xyz="0.00027 -0.01244 -0.00010" rpy="1.57992 -0.03063 1.56656" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/left_leg_pitch_5.STL" />
      </geometry>
      <material name="dark_blue" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 18190-triangle mesh collision) -->
      <origin xyz="-0.0194 -0.0142 -0.0187" rpy="0 0 0" />
      <geometry>
        <box size="0.1015 0.0525 0.0653" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="-0.0218 -0.0124 -0.0184" rpy="0 0 0" />
      <mass value="0.239" />
      <inertia ixx="9.417e-05" ixy="8.157e-07" ixz="-8.773e-06" iyy="0.0002407" iyz="8.967e-07" izz="0.000206" />
    </inertial>
  </link>

  <!-- Left ankle roll joint -->
  <joint name="l_ank_roll" type="revolute">
    <parent link="l_ank_pitch_link" />
    <child link="l_ank_roll_link" />
    <origin xyz="0.007 -0.012 -0.036" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="l_ank_roll_link">
    <visual>
      <origin xyz="0.00484 0.00681 -0.00019" rpy="1.57992 -0.03063 1.56656" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/left_leg_roll_5.STL" />
      </geometry>
      <material name="off_white" />
    </visual>
    <!-- collision removed: the l_sole/r_sole box is the foot contact -->
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="-0.0211 0.0118 -0.0295" rpy="0 0 0" />
      <mass value="0.033" />
      <inertia ixx="1.306e-05" ixy="2.1e-09" ixz="2.587e-08" iyy="2.797e-05" iyz="7.258e-07" izz="3.374e-05" />
    </inertial>
  </link>

  <!-- Left sole: fixed contact frame (duplicate visual mesh removed) -->
  <joint name="l_sole_joint" type="fixed">
    <parent link="l_ank_roll_link" />
    <child link="l_sole" />
    <origin xyz="0 0.007 -0.033" rpy="0 0 0" />
  </joint>

  <link name="l_sole">
    <collision>
      <origin xyz="-0.003 0.003 0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.145 0.095 0.012" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.001 0.003 -0.000" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00003" />
    </inertial>
  </link>

  <!-- === Right Leg === -->

  <!-- Right hip yaw joint -->
  <joint name="r_hip_yaw" type="revolute">
    <parent link="body_link" />
    <child link="r_hip_yaw_link" />
    <origin xyz="0.024 -0.046 0.039" rpy="0 0 0" />
    <axis xyz="0 0 -1" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="r_hip_yaw_link">
    <visual>
      <origin xyz="0.00007 0.00024 -0.04250" rpy="1.56403 -0.02889 1.53240" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_leg_yaw_2.STL" />
      </geometry>
      <material name="light_gray" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 3672-triangle mesh collision) -->
      <origin xyz="0.0002 0.0002 -0.0660" rpy="0 0 0" />
      <geometry>
        <box size="0.0595 0.0282 0.0475" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="0.0012 0.0002 -0.0528" rpy="0 0 0" />
      <mass value="0.023" />
      <inertia ixx="4.476e-06" ixy="3.284e-08" ixz="7.352e-07" iyy="1.321e-05" iyz="-2.438e-09" izz="1.202e-05" />
    </inertial>
  </link>

  <!-- Right hip roll joint -->
  <joint name="r_hip_roll" type="revolute">
    <parent link="r_hip_yaw_link" />
    <child link="r_hip_roll_link" />
    <origin xyz="-0.061 0.001 -0.077" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="r_hip_roll_link">
    <visual>
      <origin xyz="0.08617 -0.00024 0.00101" rpy="1.56091 -0.02470 1.53353" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_leg_roll_2.STL" />
      </geometry>
      <material name="off_white" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 17494-triangle mesh collision) -->
      <origin xyz="0.0365 0.0011 -0.0159" rpy="0 0 0" />
      <geometry>
        <box size="0.1015 0.0535 0.0644" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="0.0344 -0.0001 -0.0144" rpy="0 0 0" />
      <mass value="0.24" />
      <inertia ixx="9.245e-05" ixy="1.846e-07" ixz="-8.324e-06" iyy="0.0002395" iyz="-8.345e-07" izz="0.0002069" />
    </inertial>
  </link>

  <!-- Right hip pitch joint -->
  <joint name="r_hip_pitch" type="revolute">
    <parent link="r_hip_roll_link" />
    <child link="r_hip_pitch_link" />
    <origin xyz="0.057 0.031 0.001" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="r_hip_pitch_link">
    <visual>
      <origin xyz="-0.00026 -0.03151 0.00004" rpy="1.56180 -0.02925 1.53338" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_leg_pitch_2.STL" />
      </geometry>
      <material name="light_blue" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 8562-triangle mesh collision) -->
      <origin xyz="0.0004 -0.0302 -0.0587" rpy="0 0 0" />
      <geometry>
        <box size="0.0407 0.0536 0.1454" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="0.0004 -0.0314 -0.0929" rpy="0 0 0" />
      <mass value="0.142" />
      <inertia ixx="0.0001372" ixy="-6.339e-08" ixz="6.444e-07" iyy="0.0001178" iyz="8.904e-07" izz="4.555e-05" />
    </inertial>
  </link>

  <!-- Right knee joint -->
  <joint name="r_knee" type="revolute">
    <parent link="r_hip_pitch_link" />
    <child link="r_knee_link" />
    <origin xyz="0.001 0.005 -0.117" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="r_knee_link">
    <visual>
      <origin xyz="0.00010 -0.03620 -0.01306" rpy="1.59835 -0.02620 -1.61035" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_leg_pitch_4.STL" />
      </geometry>
      <material name="light_blue" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 5084-triangle mesh collision) -->
      <origin xyz="0.0004 -0.0366 -0.0581" rpy="0 0 0" />
      <geometry>
        <box size="0.0288 0.0522 0.1178" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="0.0004 -0.0366 -0.0581" rpy="0 0 0" />
      <mass value="0.024" />
      <inertia ixx="3.958e-05" ixy="-5.096e-08" ixz="1.494e-07" iyy="2.682e-05" iyz="1.223e-08" izz="1.609e-05" />
    </inertial>
  </link>

  <!-- Right ankle pitch joint -->
  <joint name="r_ank_pitch" type="revolute">
    <parent link="r_knee_link" />
    <child link="r_ank_pitch_link" />
    <origin xyz="0.001 -0.051 -0.117" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="r_ank_pitch_link">
    <visual>
      <origin xyz="-0.00000 0.01439 -0.00012" rpy="1.58033 -0.03041 1.53346" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_leg_pitch_6.STL" />
      </geometry>
      <material name="dark_blue" />
    </visual>
