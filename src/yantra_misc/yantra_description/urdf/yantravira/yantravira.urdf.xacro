      <inertia ixx="9.29e-05" ixy="-7.511e-07" ixz="-8.039e-06" iyy="0.0002399" iyz="-1.412e-06" izz="0.0002048" />
    </inertial>
  </link>

  <!-- Right ankle roll joint -->
  <joint name="r_ank_roll" type="revolute">
    <parent link="r_ank_pitch_link" />
    <child link="r_ank_roll_link" />
    <origin xyz="0.006 0.014 -0.036" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit effort="12.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
