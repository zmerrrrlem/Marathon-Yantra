  <link name="r_ank_roll_link">
    <visual>
      <origin xyz="-0.02022 0.00675 0.00003" rpy="1.58033 -0.03041 1.53346" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_leg_roll_6.STL" />
      </geometry>
      <material name="off_white" />
    </visual>
    <!-- collision removed: the l_sole/r_sole box is the foot contact -->
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="-0.0462 0.0020 -0.0293" rpy="0 0 0" />
      <mass value="0.033" />
      <inertia ixx="1.306e-05" ixy="8.929e-08" ixz="2.84e-08" iyy="2.797e-05" iyz="-7.529e-07" izz="3.373e-05" />
    </inertial>
  </link>

  <!-- Right sole: fixed contact frame (duplicate visual mesh removed) -->
  <joint name="r_sole_joint" type="fixed">
    <parent link="r_ank_roll_link" />
    <child link="r_sole" />
    <origin xyz="0 0 -0.033" rpy="0 0 0" />
  </joint>

  <link name="r_sole">
    <collision>
      <origin xyz="-0.003 -0.003 0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.145 0.095 0.012" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.001 -0.002 -0.000" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00003" />
    </inertial>
  </link>

  <!-- === Arms === -->

  <!-- Left shoulder pitch joint -->
  <joint name="l_sho_pitch" type="revolute">
    <parent link="body_link" />
    <child link="l_sho_pitch_link" />
    <origin xyz="-0.007 0.065 0.185" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="6.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="l_sho_pitch_link">
    <visual>
      <origin xyz="0.00011 -0.01410 0.00014" rpy="1.56168 -0.02839 1.55137" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/left_arm_pitch_1.STL" />
      </geometry>
      <material name="light_gray" />
    </visual>
    <collision>
      <!-- simple box fitted to the mesh (replaces 3168-triangle mesh collision) -->
      <origin xyz="0.0003 0.0334 -0.0136" rpy="0 0 0" />
      <geometry>
        <box size="0.0476 0.0541 0.0500" />
      </geometry>
    </collision>
    <inertial>
      <!-- centre of mass and inertia computed from the (corrected) mesh, scaled to the original mass -->
      <origin xyz="0.0012 0.0275 -0.0065" rpy="0 0 0" />
      <mass value="0.013" />
      <inertia ixx="6.64e-06" ixy="-2.726e-07" ixz="3.017e-07" iyy="6.771e-06" iyz="1.896e-06" izz="9.486e-06" />
    </inertial>
  </link>

  <!-- Left shoulder roll joint -->
  <joint name="l_sho_roll" type="revolute">
    <parent link="l_sho_pitch_link" />
    <child link="l_sho_roll_link" />
    <origin xyz="-0.004 0.050 -0.028" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit effort="6.0" velocity="7.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

