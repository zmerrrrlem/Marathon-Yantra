      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_arm_pitch_2.STL" />
      </geometry>
      <material name="light_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_arm_pitch_2.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.013" />
      <inertia ixx="1.42e-06" ixy="0" ixz="0" iyy="2.00e-06" iyz="0" izz="2.72e-06" />
    </inertial>
  </link>

  <!-- Right shoulder roll joint -->
  <joint name="r_sho_roll" type="revolute">
    <parent link="r_sho_pitch_link" />
    <child link="r_sho_roll_link" />
    <origin xyz="-0.004 -0.044 -0.028" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit effort="1000" velocity="100" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="r_sho_roll_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_arm_roll_2.STL" />
      </geometry>
      <material name="medium_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_arm_roll_2.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.139" />
      <inertia ixx="2.48e-05" ixy="0" ixz="0" iyy="1.74e-05" iyz="0" izz="2.55e-05" />
    </inertial>
  </link>

  <!-- Right elbow joint -->
  <joint name="r_el" type="revolute">
    <parent link="r_sho_roll_link" />
    <child link="r_el_link" />
    <origin xyz="-0.016 -0.013 -0.093" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="1000" velocity="100" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="r_el_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_arm_pitch_4.STL" />
      </geometry>
      <material name="light_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_arm_pitch_4.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.085" />
      <inertia ixx="1.49e-05" ixy="0" ixz="0" iyy="1.65e-05" iyz="0" izz="1.50e-05" />
    </inertial>
  </link>

  <!-- Right claw joint -->
  <joint name="r_claw" type="revolute">
    <parent link="r_el_link" />
    <child link="r_claw_link" />
    <origin xyz="0.0003 -0.036 0.005" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit effort="500" velocity="50" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="r_claw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_claw.STL" />
      </geometry>
      <material name="cyan" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/right_claw.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.013" />
      <inertia ixx="4.32e-06" ixy="0" ixz="0" iyy="3.23e-06" iyz="0" izz="5.40e-06" />
    </inertial>
  </link>

  <!-- === Head === -->

  <!-- Head pan joint -->
  <joint name="head_pan" type="revolute">
    <parent link="body_link" />
    <child link="head_pan_link" />
    <origin xyz="0.019 -0.001 0.185" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="1000" velocity="100" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="head_pan_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/head_yaw.STL" />
      </geometry>
      <material name="light_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/head_yaw.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.085" />
      <inertia ixx="1.07e-05" ixy="0" ixz="0" iyy="1.31e-05" iyz="0" izz="8.22e-06" />
    </inertial>
  </link>

  <!-- Head tilt joint -->
  <joint name="head_tilt" type="revolute">
    <parent link="head_pan_link" />
    <child link="head_tilt_link" />
    <origin xyz="0.019 0.000 0.043" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="1000" velocity="100" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>

  <link name="head_tilt_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/head_pitch.STL" />
      </geometry>
      <material name="light_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://yantra_description/meshes/yantravira/head_pitch.STL" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.215" />
      <inertia ixx="5.79e-05" ixy="0" ixz="0" iyy="3.05e-05" iyz="0" izz="3.42e-05" />
    </inertial>
  </link>

  <!-- Camera joint: fixed to head_tilt_link -->
  <joint name="camera_joint" type="fixed">
    <parent link="head_tilt_link" />
    <child link="cam_link" />
    <origin xyz="0.003 0 0.047" rpy="0 1.571 0" />
  </joint>

  <!-- cam_link is defined in yantra_compose.urdf.xacro (visual/collision/inertial) -->

</robot>