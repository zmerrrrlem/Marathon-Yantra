<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="alfarobi">

  <!-- Change the value in the launch file -->
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="real_mode" default="false" />
  <xacro:arg name="sim_mode" default="false" />
  <xacro:arg name="mock_mode" default="true"/>
  <xacro:arg name="initial_positions_file" default="offset.yaml" />

  <xacro:include filename="$(find yantra_description)/urdf/alfarobi/alfarobi.visuals.xacro" />
  <xacro:include filename="$(find yantra_description)/urdf/alfarobi/alfarobi.inertia.xacro" />

  <xacro:include filename="$(find yantra_description)/urdf/alfarobi/alfarobi.structure.rleg.xacro" />
  <xacro:include filename="$(find yantra_description)/urdf/alfarobi/alfarobi.structure.lleg.xacro" />
  <xacro:include filename="$(find yantra_description)/urdf/alfarobi/alfarobi.structure.rarm.xacro" />
  <xacro:include filename="$(find yantra_description)/urdf/alfarobi/alfarobi.structure.larm.xacro" />
  <xacro:include filename="$(find yantra_description)/urdf/alfarobi/alfarobi.structure.head.xacro" />
  <xacro:include filename="$(find yantra_description)/urdf/alfarobi/materials.xacro" />

  <xacro:include filename="$(find yantra_description)/gazebo/alfarobi.gazebo.xacro" />

  <xacro:include filename="$(find yantra_description)/ros2_control/yantra.ros2_control.xacro" />


  <link name="odom" />

  <joint name="base_fixed" type="fixed">
    <parent link="odom" />
    <child link="body_link" />
    <origin xyz="0 0 0.0" rpy="0 0 0" />
  </joint>

  <!--   body link-->
  <link name="body_link">
    <visual>
      <xacro:insert_mesh_body_link />
    </visual>
    <collision>
      <xacro:insert_mesh_body_link />
    </collision>
    <inertial>
      <xacro:insert_inertia_body_link />
    </inertial>
  </link>

  <!-- imu joint -->
  <joint name="imu_fixed" type="fixed">
    <parent link="body_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="imu_link"/>

  <!-- leg links -->
  <xacro:alfarobi_l_leg parent="body_link" />
  <xacro:alfarobi_r_leg parent="body_link" />

  <!-- arm links -->
  <xacro:alfarobi_l_arm parent="body_link" />
  <xacro:alfarobi_r_arm parent="body_link" />

  <!-- head links -->
  <xacro:alfarobi_head parent="body_link" />

  <xacro:yantra_ros2_control
    name="alfarobi" prefix="$(arg prefix)" real_mode="$(arg real_mode)" sim_mode="$(arg sim_mode)" mock_mode="$(arg mock_mode)" initial_positions_file="$(arg initial_positions_file)"/>

  <xacro:if value="$(arg sim_mode)">
    <xacro:include filename="$(find yantra_description)/gazebo/alfarobi.gazebo.xacro" />
    <xacro:alfarobi_gazebo prefix="$(arg prefix)" />  
  </xacro:if>

</robot>