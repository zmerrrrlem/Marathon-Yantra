<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find altair_description)/ros2_control/hardware_snippet.xacro" />

  <!-- README! -->
  <!-- This is xacro file is for configure ros2_control, managing available hardware: sensors,
  joints, etc.
  This configuration will be used by ros2_control hardware abstraction, there are 20 joints, 1 IMU,
  and 1 Microcontroller hardware.
  There are 3 modes available: 
  1. real_mode: true = ros2_control will call MicrocontrollerHardware and DynamixelHardware. This is
  used for real robot.
  2. mock_mode: true = ros2_control will call GenericSystem. This is used for simulation with mock
  mode. or no pyshics sim, just a mock.
  3. sim_mode: true  = ros2_control will call GazeboSimSystem. This is used for simulation with gazebo
  sim.
  !!! Caution !!! Modes can only be set true for single mode. It cant be true for multiple mode. Set
  it with caution.
  Modes can be set in launch file. -->

  <!-- param: name, prefix, sim_mode: optional(default true), mock_mode: optional(default false),
  initial_position_file: initial_position.yaml -->
  <xacro:macro name="altair_ros2_control"
    params="name prefix:=^|altair real_mode:=^|false sim_mode:=^|false mock_mode:=^|false offset_file initial_position_file tuning_mode=^|false dxl_unavailable=^|false imu_unavailable=^|false dynamixel_port dynamixel_baudrate stm32_port stm32_baudrate">
    <!-- Only activate Microcontroller & Dynamixel hardware on real robot -->
    <!-- sim_mode == false -->
    <xacro:if value="${real_mode}">
      <!-- <xacro:unless value="${imu_unavailable}">
        <ros2_control name="Microcontroller" type="sensor" is_async="true" thread_priority="10" rw_rate="125">
          <hardware>
            <plugin>altair_hardware/MicrocontrollerHardware</plugin>
            <param name="sensor_name">imu_sensor</param>
            <param name="portname">${stm32_port}</param>
            <param name="baudrate">${stm32_baudrate}</param>
          </hardware>

          <sensor name="imu_sensor">
            <state_interface name="orientation.x" />
            <state_interface name="orientation.y" />
            <state_interface name="orientation.z" />
            <state_interface name="orientation.w" />
            <state_interface name="angular_velocity.x" />
            <state_interface name="angular_velocity.y" />
            <state_interface name="angular_velocity.z" />
            <state_interface name="linear_acceleration.x" />
            <state_interface name="linear_acceleration.y" />
            <state_interface name="linear_acceleration.z" />
            <param name="frame_id">imu_link</param>
          </sensor>
          <sensor name="button">
            <state_interface name="button_msg" />
          </sensor>
        </ros2_control>
      </xacro:unless> -->

      <!-- DYNAMIXEL COMMUNITY-->
      <ros2_control name="Dynamixel" type="system" is_async="true" thread_priority="10" rw_rate="125">
        <hardware>
          <plugin>altair_hardware/DynamixelHardware</plugin>
          <param name="portname">${dynamixel_port}</param>
          <param name="baudrate">${dynamixel_baudrate}</param>
          <param name="sim_mode">${dxl_unavailable}</param>
          <param name="tuning_mode">${tuning_mode}</param>
          <param name="dynamixel_state_pub_msg_name">dynamixel_hardware/dxl_state</param>
          <param name="get_dynamixel_data_srv_name">dynamixel_hardware/get_dxl_data</param>
          <param name="set_dynamixel_data_srv_name">dynamixel_hardware/set_dxl_data</param>
          <param name="reboot_dxl_srv_name">dynamixel_hardware/reboot_dxl</param>
          <param name="set_dxl_torque_srv_name">dynamixel_hardware/set_dxl_torque</param>
          <param name="set_init_pose_srv_name">dynamixel_hardware/set_init_pose</param>
          <param name="set_dxl_torque_id_srv_name">dynamixel_hardware/torque_enable</param>
          <param name="set_ping_srv_name">dynamixel_hardware/ping</param>

        </hardware>
        <xacro:hardware_snippet_real offset_file="$(arg offset_file)" />
      </ros2_control>

    </xacro:if>

    <!-- mock_mode == true -->
    <xacro:if value="${mock_mode}">
      <ros2_control name="MockHardwareSystem" type="system">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">false</param>
        </hardware>

        <sensor name="imu_sensor">
          <state_interface name="orientation.x" />
          <state_interface name="orientation.y" />
          <state_interface name="orientation.z" />
          <state_interface name="orientation.w" />
          <state_interface name="angular_velocity.x" />
          <state_interface name="angular_velocity.y" />
          <state_interface name="angular_velocity.z" />
          <state_interface name="linear_acceleration.x" />
          <state_interface name="linear_acceleration.y" />
          <state_interface name="linear_acceleration.z" />
          <param name="frame_id">imu_link</param>
        </sensor>
        <sensor name="button">
          <state_interface name="button_msg" />
        </sensor>

        <!-- reusing hardware_snippet xacro-->
        <xacro:hardware_snippet_mock initial_position_file="$(arg initial_position_file)" />

      </ros2_control>
    </xacro:if>

    <xacro:if value="${sim_mode}">
      <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <sensor name="imu_sensor">
          <state_interface name="orientation.x" />
          <state_interface name="orientation.y" />
          <state_interface name="orientation.z" />
          <state_interface name="orientation.w" />
          <state_interface name="angular_velocity.x" />
          <state_interface name="angular_velocity.y" />
          <state_interface name="angular_velocity.z" />
          <state_interface name="linear_acceleration.x" />
          <state_interface name="linear_acceleration.y" />
          <state_interface name="linear_acceleration.z" />
          <param name="frame_id">imu_link</param>
        </sensor>
        <sensor name="button">
          <state_interface name="button_msg" />
        </sensor>

        <!-- reusing hardware_snippet xacro-->
        <xacro:hardware_snippet_mock initial_position_file="$(arg initial_position_file)" />

      </ros2_control>
    </xacro:if>

  </xacro:macro>
</robot>