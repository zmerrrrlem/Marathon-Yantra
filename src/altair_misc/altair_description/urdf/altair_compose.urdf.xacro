<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="altair">

  <!-- Change the value in the launch file -->
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="real_mode" default="false" />
  <xacro:arg name="sim_mode" default="false" />
  <xacro:arg name="mock_mode" default="false"/>
  <xacro:arg name="tuning_mode" default="false" />
  <xacro:arg name="dxl_unavailable" default="false" />
  <xacro:arg name="imu_unavailable" default="false" />
  <xacro:arg name="dynamixel_port" default="/dev/ttyUSB0" />
  <xacro:arg name="dynamixel_baudrate" default="1000000" />
  <xacro:arg name="stm32_port" default="/dev/ttyACM0" />
  <xacro:arg name="stm32_baudrate" default="115200" />
  <xacro:arg name="offset_file" default="offset.yaml" />
  <xacro:arg name="initial_position_file" default="initial_position.yaml" />

  <xacro:include filename="$(find altair_description)/urdf/altair/altair.visuals.xacro" />
  <xacro:include filename="$(find altair_description)/urdf/altair/altair.inertia.xacro" />
  <xacro:include filename="$(find altair_description)/urdf/altair/altair.collisions.xacro" />

  <xacro:include filename="$(find altair_description)/urdf/altair/altair.structure.rleg.xacro" />
  <xacro:include filename="$(find altair_description)/urdf/altair/altair.structure.lleg.xacro" />
  <xacro:include filename="$(find altair_description)/urdf/altair/altair.structure.rarm.xacro" />
  <xacro:include filename="$(find altair_description)/urdf/altair/altair.structure.larm.xacro" />
  <xacro:include filename="$(find altair_description)/urdf/altair/altair.structure.head.xacro" />

  <xacro:include filename="$(find altair_description)/ros2_control/altair.ros2_control.xacro" />

  <!-- TF -->
  <!-- base_link => body_link => limbs -->
  <!--           => base_footprint     -->

  <link name="base_link"/>
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0.0 0.0 -0.343" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_body" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!--   body link-->
  <link name="body_link">
    <visual>
      <xacro:insert_mesh_body_link />
    </visual>
    <collision>
      <xacro:insert_mesh_body_link />
    </collision>
    <inertial>
      <xacro:insert_inertia_body_link />
    </inertial>
  </link>

  <!-- imu joint -->
  <joint name="imu_fixed" type="fixed">
    <parent link="body_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="imu_link"/>

  <!-- leg links -->
  <xacro:altair_left_leg parent="body_link" />
  <xacro:altair_right_leg parent="body_link" />

  <!-- arm links -->
  <xacro:altair_left_arm parent="body_link" />
  <xacro:altair_right_arm parent="body_link" />

  <!-- head links -->
  <xacro:altair_head parent="body_link" />

  <xacro:altair_ros2_control
    name="altair" prefix="$(arg prefix)" real_mode="$(arg real_mode)" sim_mode="$(arg sim_mode)" mock_mode="$(arg mock_mode)" offset_file="$(arg offset_file)" initial_position_file="$(arg initial_position_file)" tuning_mode="$(arg tuning_mode)" dxl_unavailable="$(arg dxl_unavailable)"  imu_unavailable="$(arg imu_unavailable)"
    dynamixel_port="$(arg dynamixel_port)" dynamixel_baudrate="$(arg dynamixel_baudrate)"
    stm32_port="$(arg stm32_port)" stm32_baudrate="$(arg stm32_baudrate)" />

  <xacro:if value="$(arg sim_mode)">
    <xacro:include filename="$(find altair_description)/gazebo/altair.gazebo.xacro" />
    <xacro:altair_gazebo prefix="$(arg prefix)" />  
  </xacro:if>

</robot>