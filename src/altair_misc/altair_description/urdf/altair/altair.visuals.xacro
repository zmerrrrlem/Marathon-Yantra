<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="insert_mesh_body_link">
    <origin xyz="0.00000 0.00000 0.00000" rpy="0.00000 0.00000 0.00000" />
    <geometry>
      <mesh filename="file://$(find altair_description)/meshes/altair/body.stl"
        scale="1.00000 1.00000 1.00000" />
    </geometry>
    <material name="254,254,255.002">
      <color rgba="0.99216 0.99216 1.00000 1.00000" />
    </material>
  </xacro:macro>

