<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="insert_collision_body_link">
    <origin xyz="0.00000 0.00000 -0.00000" rpy="0.00000 0.00000 0.00000" />
    <geometry>
      <box size="0.12000 0.14000 0.18700" />
    </geometry>
  </xacro:macro>

  <xacro:macro name="insert_collision_head_pan_link">
    <origin rpy="0.00000 0.00000 0.00000" xyz="0.00732 -0.00037 0.06110"/>
    <geometry>
      <mesh filename="$(find altair_description)/meshes/altair/neck.stl" scale="1.00000 1.00000 1.00000" />
    </geometry>
  </xacro:macro>

  <xacro:macro name="insert_collision_head_tilt_link">
    <origin xyz="0.00311 0.04018 0.00443" rpy="-1.57080 0.00000 0.00000" />
    <geometry>
      <mesh filename="$(find altair_description)/meshes/altair/camera.stl" scale="1.00000 1.00000 1.00000" />
    </geometry>
  </xacro:macro>

