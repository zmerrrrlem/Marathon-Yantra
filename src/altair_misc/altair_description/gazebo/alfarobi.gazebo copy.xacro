<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="alfarobi_gazebo" params="prefix">

    <!-- ros_control plugin -->
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find altair_description)/config/alfarobi_config.yaml</parameters>
      </plugin>
      <!-- IMU -->
      <plugin filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
      </plugin>
    </gazebo>

    
    <!-- body link -->
    <gazebo reference="body_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/White</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>
    </gazebo>

    <!-- left leg links -->
    <gazebo reference="l_hip_yaw_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="l_hip_roll_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>


    </gazebo>

    <gazebo reference="l_hip_pitch_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/White</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>


    </gazebo>

    <gazebo reference="l_knee_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/White</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="l_ank_pitch_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="l_ank_roll_link">
      <kp>100000.0</kp>
      <kd>100.0</kd>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <fdir1>1 0 0</fdir1>
      <maxVel>1.0</maxVel>
      <minDepth>0.001</minDepth>
      <material>Gazebo/White</material>
      <gravity>true</gravity>

    </gazebo>


    <!-- right leg links -->
    <gazebo reference="r_hip_yaw_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="r_hip_roll_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="r_hip_pitch_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/White</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="r_knee_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/White</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="r_ank_pitch_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="r_ank_roll_link">
      <mu1>9000</mu1>
      <kp>100000.0</kp>
      <kd>100.0</kd>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <fdir1>1 0 0</fdir1>
      <maxVel>1.0</maxVel>
      <minDepth>0.001</minDepth>
      <material>Gazebo/White</material>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="r_sho_pitch_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="r_sho_roll_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/White</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="r_el_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/White</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="l_sho_pitch_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="l_sho_roll_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/White</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="l_el_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/White</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="head_pan_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="head_tilt_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <material>Gazebo/Grey</material>
      <selfCollide>false</selfCollide>
      <gravity>true</gravity>

    </gazebo>

    <gazebo reference="cam_gazebo_link">
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>gazebo/camera/image_raw</topic>
        <gz_frame_id>cam_link</gz_frame_id>
        <camera name="__default__">
          <camera_info_topic>gazebo/camera/camera_info</camera_info_topic>
          <horizontal_fov>1.012300</horizontal_fov>
          <image>
            <width>320</width>
            <height>200</height>
          </image>
          <clip>
            <near>0.001000</near>
            <far>100.000000</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>


    <!-- imu sensor -->
    <gazebo reference="imu_link">
      <gravity>true</gravity>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <visualize>true</visualize>
        <topic>gazebo/imu</topic>
        <pose>0 0 0 0 0 0</pose>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>