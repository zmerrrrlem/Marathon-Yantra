<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="altair_gazebo" params="prefix">

    <!-- ros_control plugin -->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find quintic_walk)/config/gazebo_sim/controller.yaml</parameters>
        <controller_manager_prefix_node_name>${prefix}/controller_manager</controller_manager_prefix_node_name>
        <ros>
          <namespace>${prefix}</namespace>
        </ros>
      </plugin>
    </gazebo>

    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Upper Body -->
    <transmission name="r_sho_pitch_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="r_sho_pitch">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="r_sho_pitch_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="l_sho_pitch_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="l_sho_pitch">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="l_sho_pitch_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="r_sho_roll_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="r_sho_roll">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="r_sho_roll_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="l_sho_roll_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="l_sho_roll">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="l_sho_roll_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="r_el_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="r_el">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="r_el_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="l_el_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="l_el">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="l_el_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <!-- Lower Body -->
    <transmission name="r_hip_yaw_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="r_hip_yaw">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="r_hip_yaw_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="l_hip_yaw_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="l_hip_yaw">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="l_hip_yaw_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="r_hip_roll_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="r_hip_roll">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="r_hip_roll_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="l_hip_roll_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="l_hip_roll">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="l_hip_roll_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="r_hip_pitch_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="r_hip_pitch">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="r_hip_pitch_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="l_hip_pitch_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="l_hip_pitch">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="l_hip_pitch_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="r_knee_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="r_knee">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="r_knee_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="l_knee_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="l_knee">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="l_knee_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="r_ank_pitch_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="r_ank_pitch">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="r_ank_pitch_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="l_ank_pitch_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="l_ank_pitch">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="l_ank_pitch_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="r_ank_roll_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="r_ank_roll">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="r_ank_roll_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="l_ank_roll_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="l_ank_roll">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="l_ank_roll_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <!-- Head -->
    <transmission name="head_pan_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="head_pan">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="head_pan_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <transmission name="head_tilt_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="head_tilt">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="head_tilt_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>


    <!-- <gazebo reference="cam_gazebo_link">
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>gazebo/camera/image_raw</topic>
        <gz_frame_id>cam_link</gz_frame_id>
        <camera name="__default__">
          <camera_info_topic>gazebo/camera/camera_info</camera_info_topic>
          <horizontal_fov>1.012300</horizontal_fov>
          <image>
            <width>320</width>
            <height>200</height>
          </image>
          <clip>
            <near>0.001000</near>
            <far>100.000000</far>
          </clip>
        </camera>
      </sensor>
    </gazebo> -->


    <!-- imu sensor -->
    <gazebo reference="imu_link">
      <gravity>true</gravity>

      <sensor name="imu_sensor" type="imu">
        <plugin filename="gz-sim-imu-system"
          name="gz::sim::systems::Imu">
        </plugin>

        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>gazebo/imu</topic>
        <pose>0 0 0 0 0 0</pose>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>