<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>dynamixel_hardware</name>
    <version>0.0.0</version>
    <description>dynamixel_hardware is a hardware interface for the dynamixel motor servo</description>

    <maintainer email="altairgmrt@gmail.com">altair</maintainer>

    <license>TODO</license>
    <author email="falahnzk@gmail.com">Falah Naufal Zaki</author>


    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>backward_ros</depend>
    <depend>hardware_interface</depend>
    <depend>pluginlib</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_lifecycle</depend>
    <depend>generate_parameter_library</depend>
    <depend>parameter_traits</depend>
    <depend>realtime_tools</depend>
    <depend>std_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>libserial-dev</depend>

    <depend>dynamixel_workbench_toolbox</depend>
    <depend>dynamixel_msgs</depend>

    <exec_depend>controller_manager</exec_depend>
    <exec_depend>forward_command_controller</exec_depend>
    <exec_depend>ros_gz_sim</exec_depend>
    <exec_depend>gz_ros2_control</exec_depend>
